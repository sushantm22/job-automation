# ==============================================================================
# Job Application Automation - Environment Configuration Template
# Copy this file to .env:  cp .env.example .env
# NEVER commit your .env file or API keys to GitHub!
# ==============================================================================

# --- LLM Provider (Optional) ---
# Not used yet: AI job scoring and resume tailoring are planned.
# Free key from Google AI Studio: https://aistudio.google.com/
LLM_PROVIDER=gemini
GEMINI_API_KEY=

# --- Tier 1 & Tier 2: 100% Free (No API Keys Required) ---
# Tier 1 (Direct ATS APIs: Greenhouse / Lever / Ashby / SmartRecruiters)
# Tier 2 (JobSpy: LinkedIn / Indeed / Glassdoor)
# Both tiers require ZERO API keys and run out of the box!

# --- Tier 3: Apify Cloud Anti-Bot (Optional: for Naukri scraping) ---
# Sign up free ($5 free monthly credits): https://console.apify.com/account/integrations
APIFY_API_TOKEN=

# --- Tier 4: Firecrawl AI Crawler (Optional: for Apple / Netflix enterprise portals) ---
# Sign up free (500 free scrape credits): https://firecrawl.dev/
FIRECRAWL_API_KEY=

# --- Notion Tabular Database Sync (Optional: for tracking opportunities) ---
# 1. Create Internal Integration token: https://www.notion.so/my-integrations
NOTION_API_KEY=
# 2. Parent Page ID where your table will live (from Notion share/copy link):
NOTION_PARENT_PAGE_ID=
# 3. Database ID (automatically populated when running: python -m src.cli init-notion-db)
NOTION_DATABASE_ID=

# --- Local Storage Configuration ---
DATABASE_PATH=data/jobs.db
